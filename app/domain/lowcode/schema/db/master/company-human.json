{
  "name": "company_human",
  "type": "object",
  "description": "公司人员关系",
  "title": "人员",
  "allOf": [
    {"$ref": "/definition/db/base.json"}
  ],
  "meta": {
    "ddd": {
      "aggField": "companyId",
      "aggType": "master.contract",
      "isPubEvent": true
    },
    "dbTable": {
      "name": "company_human",
       "dbKey": "$db"
    },
    "attributes": {
      "neo4j":{
        "labels": ["human"],
        "title": "人员",
        "type": ["rel","node"]
      }
    },
    "graph": {
      "isEnable": true,
      "labels": ["case_${caseId}", "human", "master"],
      "graphType": ["rel","node"],
      "relStart": "${companyId}",
      "relEnd": "${id}",
      "relType": "own"
    }
  },
  "properties": {
    "caseId": {
      "name": "caseId",
      "title": "项目Id",
      "type": "string",
      "order": 2001,
      "meta": {
        "dbField": {
          "readable": true,
          "nodeLabelFormat": "case_%s",
          "nodeLabel": true
        },
        "column": {
          "hide": true
        }
      }
    },
    "companyId": {
      "title": "公司Id",
      "type": "string",
      "order": 2001,
      "meta": {
        "dbField": {
          "readable": true
        },
        "column": {
          "hide": true
        }
      }
    },
    "relationType": {
      "name": "relationType",
      "order": 2001,
      "title": "关系类型",
      "type": ["string", "null"],
      "meta": {
        "column": {
          "type": "dropdown",
          "source": "[\"\",\"股东\", \"法人\", \"董事长\", \"监事\", \"高管\", \"财务\"]"
        },
        "dbField": {
          "relType": true
        }
      }
    },
    "name": {
      "name": "name",
      "type": ["string", "null"],
      "title": "姓名",
      "order": 2003
    },
    "gender": {
      "name": "gender",
      "type": ["string", "null"],
      "title": "性别",
      "order": 2007
    },
    "age": {
      "name": "age",
      "type": ["integer", "null"],
      "title": "年龄",
      "order": 2005
    },
    "identNum": {
      "name": "identNum",
      "type": ["string", "null"],
      "title": "证件号",
      "order": 2006
    },
    "link": {
      "name": "link",
      "type": ["string", "null"],
      "title": "联系方式",
      "order": 2008
    },
    "addr": {
      "name": "addr",
      "type": ["string", "null"],
      "title": "地址",
      "order": 2009
    }
  }
}
