{
  "name": "human_company",
  "type": "object",
  "description": "人员公司关系",
  "allOf": [
    {"$ref": "/definition/db/base.json"}
  ],
  "meta": {
    "ddd": {
      "aggField": "humanId",
      "aggType": "master.human",
      "isPubEvent": true
    },
