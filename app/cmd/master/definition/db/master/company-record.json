          "readable": true,
          "nodeLabelFormat": "case_%s",
          "nodeLabel": true
        },
        "column": {
          "hide": true
        }
      }
    },
    "relationType": {
      "name": "relationType",
      "order": 108,
      "title": "关系类型",
      "type": ["string", "null"],
      "meta": {
      }
    },
    "companyId": {
      "name": "companyId",
      "order": 102,
      "title": "公司Id",
      "type": "string",
      "meta": {
        "dbField": {
          "readable": true
        },
        "column": {
          "hide": true
        }
      }
    },
    "title": {
      "name": "title",
      "order": 108,
      "title": "标题",
      "type": [
        "string",
        "null"
      ],
      "meta": {
        "dbField": {
          "creatable": false,
          "updatable": false,
          "readable": true,
          "relEnId": true
        },
        "column": {
          "hide": true
        }
      }
    },
    "content": {
      "name": "content",
      "order": 107,
      "title": "内容",
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "name": "status",
      "order": 112,
      "title": "分析状态",
      "type": [
        "string",
        "null"
      ]
    },
    "recordTime": {
      "name": "recordTime",
      "order": 106,
      "title": "记录时间",
      "type": [
        "date",
        "null"
      ]
