package vo

// RoleUserDataVo 对应Java的RoleUserDataVo类，继承BaseVo
type RoleUserDataVo struct {
	BaseVo          // 继承BaseVo
	TenantID string `gorm:"type:varchar(36)" json:"tenantId"` // 租户ID
	RoleID   string `gorm:"type:varchar(36)" json:"roleId"`   // 角色ID
	UserID   string `gorm:"type:varchar(36)" json:"userId"`   // 用户ID
}
